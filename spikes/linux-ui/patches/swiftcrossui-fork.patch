+import CGtk
+
+/// Content-addressed, refcounted stylesheets for per-widget CSS (fork change).
+///
+/// Each distinct set of declarations gets one class (`scui-s<n>`) and one
+/// display-wide provider. A provider is dropped when the last widget using
+/// it changes style or is deallocated, so dynamic values (colors that follow
+/// a meter, say) don't accumulate.
+public enum SharedWidgetStyles {
+    public struct Key: Hashable {
+        var plain: String
+        var focus: String
+        var focusWithin: String
+        var isEmpty: Bool { plain.isEmpty && focus.isEmpty && focusWithin.isEmpty }
+    }
+
+    public final class Style {
+        let key: Key
+        let className: String
+        let provider: CSSProvider
+        var references = 0
+
+        init(key: Key, className: String) {
+            self.key = key
+            self.className = className
+            provider = CSSProvider()
+            var text = ""
+            if !key.focusWithin.isEmpty { text += ".\(className):focus-within{\(key.focusWithin)}" }
+            if !key.focus.isEmpty { text += ".\(className):focus{\(key.focus)}" }
+            if !key.plain.isEmpty { text += ".\(className){\(key.plain)}" }
+            provider.loadCss(from: text)
+        }
+    }
+
+    nonisolated(unsafe) private static var styles: [Key: Style] = [:]
+    nonisolated(unsafe) private static var nextID = 0
+
+    /// The number of live shared stylesheets (for diagnostics).
+    public static var count: Int { styles.count }
+
+    static func acquire(_ key: Key) -> Style {
+        if let style = styles[key] {
+            style.references += 1
+            return style
+        }
+        nextID += 1
+        let style = Style(key: key, className: "scui-s\(nextID)")
+        style.references = 1
+        styles[key] = style
+        return style
+    }
+
+    static func release(_ style: Style) {
+        style.references -= 1
+        if style.references <= 0 {
+            styles[style.key] = nil
+        }
+    }
+}
