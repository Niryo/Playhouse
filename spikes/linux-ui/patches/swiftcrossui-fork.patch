+import Foundation
+
+// Fork addition (POC): SwiftUI-style animations for SwiftCrossUI.
+//
+// Model: an update that runs inside an animation transaction (`withAnimation`,
+// or the subtree of an `.animation(_:value:)` whose value changed) doesn't
+// apply its new geometry at once. The backend reports each committed size,
+// position and insertion to `Animator`, which interpolates from the
+// on-screen value to the new one on every frame with the transaction's
+// curve. Shapes re-evaluate their path at each interpolated size, and views
+// inserted by the transaction fade in. Removal transitions and animatable
+// view properties (colors, custom `animatableData`) are not implemented.
+
+/// The timing of an animation: a curve and a duration (or a spring).
+public struct Animation: Sendable, Equatable {
+    enum Curve: Sendable, Equatable {
+        case linear
+        case bezier(Double, Double, Double, Double)
+        case spring(response: Double, dampingFraction: Double)
+    }
+
+    var curve: Curve
+    /// The duration in seconds (for springs, the time to settle).
+    public private(set) var duration: Double
+    var delay: Double = 0
+
+    public static func linear(duration: Double) -> Animation {
+        Animation(curve: .linear, duration: duration)
+    }
+    public static func easeIn(duration: Double) -> Animation {
+        Animation(curve: .bezier(0.42, 0, 1, 1), duration: duration)
+    }
+    public static func easeOut(duration: Double) -> Animation {
+        Animation(curve: .bezier(0, 0, 0.58, 1), duration: duration)
+    }
+    public static func easeInOut(duration: Double) -> Animation {
+        Animation(curve: .bezier(0.42, 0, 0.58, 1), duration: duration)
+    }
+    public static func timingCurve(
+        _ c0x: Double, _ c0y: Double, _ c1x: Double, _ c1y: Double, duration: Double
+    ) -> Animation {
+        Animation(curve: .bezier(c0x, c0y, c1x, c1y), duration: duration)
+    }
+    /// A damped spring. `response` is the period of the undamped spring in
+    /// seconds; `dampingFraction` < 1 overshoots, 1 is critically damped.
+    public static func spring(response: Double = 0.5, dampingFraction: Double = 0.825) -> Animation {
+        let omega = 2 * Double.pi / max(response, 0.001)
+        let zeta = max(dampingFraction, 0.01)
+        // Time for the envelope to fall below 0.1%.
+        let settle = zeta < 1 ? log(1000) / (zeta * omega) : 9.2 / omega
+        return Animation(curve: .spring(response: response, dampingFraction: zeta), duration: settle)
+    }
+
+    public static var linear: Animation { .linear(duration: 0.35) }
+    public static var easeIn: Animation { .easeIn(duration: 0.35) }
+    public static var easeOut: Animation { .easeOut(duration: 0.35) }
+    public static var easeInOut: Animation { .easeInOut(duration: 0.35) }
+    public static var spring: Animation { .spring() }
+    public static var bouncy: Animation { .spring(response: 0.5, dampingFraction: 0.7) }
+    public static var smooth: Animation { .spring(response: 0.5, dampingFraction: 1) }
+    public static var snappy: Animation { .spring(response: 0.3, dampingFraction: 0.85) }
+    public static var `default`: Animation { .spring(response: 0.55, dampingFraction: 1) }
+
+    public func delay(_ seconds: Double) -> Animation {
+        var copy = self
+        copy.delay += seconds
+        return copy
+    }
+
+    public func speed(_ speed: Double) -> Animation {
+        var copy = self
+        copy.duration /= max(speed, 0.001)
+        if case .spring(let response, let damping) = curve {
+            copy.curve = .spring(response: response / max(speed, 0.001), dampingFraction: damping)
+        }
+        return copy
+    }
+
+    /// The fraction (0 → 1, may overshoot for springs) at `elapsed` seconds.
+    func fraction(at elapsed: Double) -> (value: Double, finished: Bool) {
+        let t = elapsed - delay
+        if t <= 0 { return (0, false) }
+        if t >= duration { return (1, true) }
+        switch curve {
+            case .linear:
+                return (t / duration, false)
+            case .bezier(let x1, let y1, let x2, let y2):
+                return (Self.cubicBezier(t / duration, x1, y1, x2, y2), false)
+            case .spring(let response, let zeta):
+                let omega = 2 * Double.pi / max(response, 0.001)
+                if zeta < 1 {
+                    let omegaD = omega * (1 - zeta * zeta).squareRoot()
+                    let envelope = exp(-zeta * omega * t)
+                    return (1 - envelope * (cos(omegaD * t) + zeta * omega / omegaD * sin(omegaD * t)), false)
+                } else {
+                    return (1 - exp(-omega * t) * (1 + omega * t), false)
+                }
+        }
+    }
+
+    /// y for x on the cubic Bézier through (0,0), (x1,y1), (x2,y2), (1,1).
+    static func cubicBezier(_ x: Double, _ x1: Double, _ y1: Double, _ x2: Double, _ y2: Double) -> Double {
+        func sample(_ t: Double, _ a1: Double, _ a2: Double) -> Double {
+            let u = 1 - t
+            return 3 * u * u * t * a1 + 3 * u * t * t * a2 + t * t * t
+        }
+        func slope(_ t: Double, _ a1: Double, _ a2: Double) -> Double {
+            let u = 1 - t
+            return 3 * u * u * a1 + 6 * u * t * (a2 - a1) + 3 * t * t * (1 - a2)
+        }
+        var t = x
+        for _ in 0..<8 {
+            let error = sample(t, x1, x2) - x
+            if abs(error) < 1e-6 { return sample(t, y1, y2) }
+            let d = slope(t, x1, x2)
+            if abs(d) < 1e-6 { break }
+            t -= error / d
+        }
+        var low = 0.0, high = 1.0
+        t = x
+        for _ in 0..<30 {
+            let value = sample(t, x1, x2)
+            if abs(value - x) < 1e-6 { break }
+            if value < x { low = t } else { high = t }
+            t = (low + high) / 2
+        }
+        return sample(t, y1, y2)
+    }
+}
+
+/// Runs `body` (typically state or model mutations) so that the view updates
+/// it causes animate with `animation`.
+@MainActor
+@discardableResult
+public func withAnimation<Result>(
+    _ animation: Animation? = .default,
+    _ body: () throws -> Result
+) rethrows -> Result {
+    let previous = Animator.pending
+    Animator.pending = animation
+    defer {
+        // Model changes reach their views through main-thread actions queued
+        // during `body`; keep the animation pending until those have run.
+        if let schedule = Animator.afterQueuedUpdates {
+            schedule { Animator.pending = previous }
+        } else {
+            Animator.pending = previous
+        }
+    }
+    return try body()
+}
+
+/// Drives geometry and opacity animations for the backend (see the comment
+/// at the top of this file).
+@MainActor
+public enum Animator {
+    /// Set by `withAnimation` until the updates it caused have run.
+    static var pending: Animation?
+    /// Set while committing the subtree of a triggered `.animation(_:value:)`.
+    static var scoped: Animation?
+    /// Set while a transaction explicitly disables animation (`withAnimation(nil)`
+    /// inside a scoped one).
+    static var disabled = false
+
+    /// The animation for geometry committed right now, if any.
+    public static var active: Animation? { disabled ? nil : (scoped ?? pending) }
+
+    /// Installed by the backend: runs an action after the main-thread
+    /// actions already queued.
+    public static var afterQueuedUpdates: ((@escaping @MainActor () -> Void) -> Void)?
+    /// Installed by the backend: calls `step` once per frame until it returns false.
+    public static var scheduleFrames: ((@escaping @MainActor () -> Bool) -> Void)?
+
+    /// Called with each interpolated size of a widget (used by shapes to
+    /// re-evaluate their path), keyed by the widget.
+    public static var sizeObservers: [ObjectIdentifier: (SIMD2<Double>) -> Void] = [:]
+
+    struct Track {
+        var from: SIMD2<Double>
+        var to: SIMD2<Double>
+        var current: SIMD2<Double>
+        /// Set on the first frame, not at commit: the commit that starts an
+        /// animation is often followed by an expensive layout and paint, which
+        /// would otherwise eat the start of the curve.
+        var start: Double?
+        /// Animation time; advances by at most `maxFrameStep` per frame so a
+        /// stalled frame delays the animation instead of skipping part of it.
+        var elapsed = 0.0
+        var lastFrame: Double?
+        var animation: Animation
+        var apply: (SIMD2<Double>) -> Void
+    }
+
+    public enum Channel: Hashable {
+        case size, position, opacity
+    }
+
+    private struct Key: Hashable {
+        var object: ObjectIdentifier
+        var channel: Channel
+    }
+
+    private static var tracks: [Key: Track] = [:]
+    private static var ticking = false
+    /// Frames rendered by running animations (diagnostics).
+    public private(set) static var framesStepped = 0
+
+    static var now: Double { ProcessInfo.processInfo.systemUptime }
+
+    /// Where `channel` of `object` is heading, if it's animating.
+    public static func target(of object: AnyObject, _ channel: Channel) -> SIMD2<Double>? {
+        tracks[Key(object: ObjectIdentifier(object), channel: channel)]?.to
+    }
+
+    /// Animates `channel` of `object` from `from` (or from where a running
+    /// animation currently is) to `to`, calling `apply` every frame.
+    public static func animate(
+        _ object: AnyObject,
+        _ channel: Channel,
+        from: SIMD2<Double>,
+        to: SIMD2<Double>,
+        animation: Animation,
+        apply: @escaping (SIMD2<Double>) -> Void
+    ) {
+        let key = Key(object: ObjectIdentifier(object), channel: channel)
+        let start = tracks[key]?.current ?? from
+        if start == to {
+            tracks[key] = nil
+            apply(to)
+            return
+        }
+        tracks[key] = Track(from: start, to: to, current: start, start: nil, animation: animation, apply: apply)
+        if debug { print("ANIM start \(channel) \(start) -> \(to) dur=\(animation.duration)") }
+        apply(start)
+        startTicking()
+    }
+
+    /// Stops animating `channel` of `object` (a non-animated update to a
+    /// different value takes over).
+    public static func cancel(_ object: AnyObject, _ channel: Channel) {
+        tracks[Key(object: ObjectIdentifier(object), channel: channel)] = nil
+    }
+
+    private static func startTicking() {
+        guard !ticking, let scheduleFrames else { return }
+        ticking = true
+        scheduleFrames { step() }
+    }
+
+    static let maxFrameStep = 1.0 / 30
+    static let debug = ProcessInfo.processInfo.environment["PH_ANIM_DEBUG"] != nil
+
+    private static func step() -> Bool {
+        let time = now
+        framesStepped += 1
+        if debug {
+            let sizes = tracks.filter { $0.key.channel == .size }.map { "\(Int($0.value.current.y))" }.joined(separator: ",")
+            print("ANIM frame \(framesStepped) t=\(Int((time.truncatingRemainder(dividingBy: 1000)) * 1000)) tracks=\(tracks.count) h=\(sizes)")
+        }
+        for (key, var track) in tracks {
+            track.start = track.start ?? time
+            if let lastFrame = track.lastFrame {
+                track.elapsed += min(time - lastFrame, maxFrameStep)
+            }
+            track.lastFrame = time
+            let (fraction, finished) = track.animation.fraction(at: track.elapsed)
+            track.current = finished ? track.to : track.from + (track.to - track.from) * fraction
+            track.apply(track.current)
+            if key.channel == .size, let observer = sizeObservers[key.object] {
+                observer(track.current)
+            }
+            if finished {
+                tracks[key] = nil
+                if key.channel == .size { sizeObservers[key.object] = nil }
+            } else {
+                tracks[key] = track
+            }
+        }
+        ticking = !tracks.isEmpty
+        return ticking
+    }
+}
+
+/// Remembers the last value seen by an `.animation(_:value:)` modifier.
+final class AnimationValueMemory {
+    var value: Any?
+}
+
+/// Animates the geometry changes of its content whenever `value` changes.
+public struct AnimationModifier<Content: View, Value: Equatable>: View {
+    var content: Content
+    var animation: Animation?
+    var value: Value
+    @State var memory = AnimationValueMemory()
+
+    public var body: some View { content }
+
+    public func commit<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget,
+        children: any ViewGraphNodeChildren,
+        layout: ViewLayoutResult,
+        environment: EnvironmentValues,
+        backend: Backend
+    ) {
+        let changed = memory.value.map { ($0 as? Value) != value } ?? false
+        memory.value = value
+        guard changed else {
+            defaultCommit(widget, children: children, layout: layout, environment: environment, backend: backend)
+            return
+        }
+        let previous = (Animator.scoped, Animator.disabled)
+        Animator.scoped = animation
+        Animator.disabled = animation == nil
+        defer { (Animator.scoped, Animator.disabled) = previous }
+        defaultCommit(widget, children: children, layout: layout, environment: environment, backend: backend)
+    }
+}
+
+extension View {
+    /// Animates this view's geometry with `animation` whenever `value` changes
+    /// (`nil` disables animation for changes in this subtree).
+    public func animation<V: Equatable>(_ animation: Animation?, value: V) -> some View {
+        AnimationModifier(content: self, animation: animation, value: value)
+    }
