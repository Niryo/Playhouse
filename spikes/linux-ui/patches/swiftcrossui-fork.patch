+import CGtk
+import Gtk
+@_spi(Backends) import SwiftCrossUI
+
+/// Fork: viewport queries and scroll observation for ``LazyVStack``.
+extension GtkBackend: LazyStackViewportSupport {
+    private func enclosingScrolledWindow(of widget: Widget) -> UnsafeMutablePointer<GtkWidget>? {
+        var parent = gtk_widget_get_parent(widget.widgetPointer)
+        let type = gtk_scrolled_window_get_type()
+        while let current = parent {
+            if g_type_check_instance_is_a(UnsafeMutableRawPointer(current).assumingMemoryBound(to: GTypeInstance.self), type) != 0 {
+                return current
+            }
+            parent = gtk_widget_get_parent(current)
+        }
+        return nil
+    }
+
+    public func visibleRange(of widget: Widget) -> (offset: Double, height: Double)? {
+        guard let scrolled = enclosingScrolledWindow(of: widget),
+            gtk_widget_get_height(scrolled) > 0
+        else { return nil }
+        var origin = graphene_point_t(x: 0, y: 0)
+        var inScrolled = graphene_point_t(x: 0, y: 0)
+        guard gtk_widget_compute_point(widget.widgetPointer, scrolled, &origin, &inScrolled) != 0 else {
+            return nil
+        }
+        return (offset: Double(-inScrolled.y), height: Double(gtk_widget_get_height(scrolled)))
+    }
+
+    public func observeScrolling(of widget: Widget, _ action: @escaping @MainActor () -> Void) -> Bool {
+        guard let scrolled = enclosingScrolledWindow(of: widget) else { return false }
+        let observer = AdjustmentObserver(scrolledWindow: OpaquePointer(scrolled)) {
+            MainActor.assumeIsolated { action() }
+        }
+        lazyStackObservers[ObjectIdentifier(widget)] = observer
+        return true
+    }
+
+    public func setRowVisible(_ widget: Widget, _ visible: Bool) {
+        if gtk_widget_get_visible(widget.widgetPointer) != (visible ? 1 : 0) {
+            gtk_widget_set_visible(widget.widgetPointer, visible ? 1 : 0)
+        }
+    }
+}
