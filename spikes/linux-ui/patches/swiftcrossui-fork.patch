+/// Fork diagnostics: layout work counters (not thread-safe; main actor only).
+public enum LayoutStats {
+    nonisolated(unsafe) public static var computed = 0
+    nonisolated(unsafe) public static var cacheHits = 0
+    nonisolated(unsafe) public static var commits = 0
+    nonisolated(unsafe) public static var textMeasurements = 0
+    nonisolated(unsafe) public static var computedByType: [String: Int] = [:]
+    nonisolated(unsafe) public static var byTypeEnabled = false
+    nonisolated(unsafe) public static var traceType: Any.Type?
+
+    public static var summary: String {
+        let top = computedByType.sorted { $0.value > $1.value }.prefix(200)
+            .map { "\($0.key)=\($0.value)" }.joined(separator: " ")
+        return "computed=\(computed) cacheHits=\(cacheHits) commits=\(commits) text=\(textMeasurements) \(top)"
+    }
+
+    public static func reset() {
+        computed = 0; cacheHits = 0; commits = 0; textMeasurements = 0; computedByType = [:]
+    }
+}
