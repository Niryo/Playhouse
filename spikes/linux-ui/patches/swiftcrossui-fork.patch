+import Foundation
+
+// Fork addition (POC): a lazily materialized vertical stack.
+//
+// Only rows overlapping the scroll view's visible rect (plus a margin) get
+// view graph nodes and widgets; the rest are estimated (average measured
+// height, or `estimatedRowHeight`). Rows that scroll away are hidden but keep
+// their nodes, so their `@State` survives. Scrolling re-runs this view's
+// layout through its node's resize hook; rows already laid out are clean and
+// reuse their layouts. Needs a backend that implements
+// ``LazyStackViewportSupport`` (GTK does); others materialize every row.
+//
+// Limitations: vertical only, content must be a single `ForEach` with an ID
+// key path, positions shift when estimated heights get measured, and
+// materialized rows are never destroyed.
+
+/// Backend support for lazy stacks: where a widget is visible inside its
+/// enclosing scroll view, and when that changes.
+@MainActor
+public protocol LazyStackViewportSupport {
+    associatedtype LazyWidget
+    /// The visible vertical range of `widget`, in its own coordinates
+    /// (`offset` = how far its top is scrolled out of view), or nil if it
+    /// isn't laid out inside a scroll view yet.
+    func visibleRange(of widget: LazyWidget) -> (offset: Double, height: Double)?
+    /// Calls `action` whenever the enclosing scroll view scrolls (at most one
+    /// registration per widget).
+    func observeScrolling(of widget: LazyWidget, _ action: @escaping @MainActor () -> Void) -> Bool
+    func setRowVisible(_ widget: LazyWidget, _ visible: Bool)
+}
+
+public struct LazyVStack<Items: RandomAccessCollection, ID: Hashable, Row: View>: TypeSafeView, View {
+    var content: ForEach<Items, ID, Row>
+    var alignment: HorizontalAlignment
+    var spacing: Double
+    var estimatedRowHeight: Double
+    /// Extra height materialized above and below the visible range.
+    var margin: Double
+
+    public var body = EmptyView()
+
+    public init(
+        alignment: HorizontalAlignment = .center,
+        spacing: Int = 8,
+        estimatedRowHeight: Double = 100,
+        margin: Double = 400,
+        content: () -> ForEach<Items, ID, Row>
+    ) {
+        self.content = content()
+        self.alignment = alignment
+        self.spacing = Double(spacing)
+        self.estimatedRowHeight = estimatedRowHeight
+        self.margin = margin
+    }
+
+    func children<Backend: BaseAppBackend>(
+        backend: Backend,
+        snapshots: [ViewGraphSnapshotter.NodeSnapshot]?,
+        environment: EnvironmentValues
+    ) -> LazyVStackChildren<ID, Row> {
+        LazyVStackChildren()
+    }
+
+    func asWidget<Backend: BaseAppBackend>(
+        _ children: LazyVStackChildren<ID, Row>,
+        backend: Backend
+    ) -> Backend.Widget {
+        backend.createContainer()
+    }
+
+    func computeLayout<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget,
+        children: LazyVStackChildren<ID, Row>,
+        proposedSize: ProposedViewSize,
+        environment: EnvironmentValues,
+        backend: Backend
+    ) -> ViewLayoutResult {
+        guard let idKeyPath = content.idKeyPath else {
+            fatalError("LazyVStack needs a ForEach with an id key path")
+        }
+        let elements = content.elements
+        let ids = elements.map { $0[keyPath: idKeyPath] }
+
+        // Drop rows whose elements are gone.
+        let live = Set(ids)
+        for (index, id) in children.order.enumerated().reversed() where !live.contains(id) {
+            backend.remove(childAt: index, from: widget)
+            children.order.remove(at: index)
+            children.nodes[id] = nil
+            children.heights[id] = nil
+        }
+        children.reindex()
+
+        let visible: ClosedRange<Double>
+        if let range = Self.visibleRange(of: widget, backend: backend) {
+            visible = (range.offset - margin)...(range.offset + range.height + margin)
+        } else {
+            visible = -margin...(1400 + margin)  // not laid out yet: assume a window's worth
+        }
+        let measured = children.heights.values
+        let estimate = measured.isEmpty ? estimatedRowHeight : measured.reduce(0, +) / Double(measured.count)
+        let rowProposal = ProposedViewSize(proposedSize.width, nil)
+        // The same environment a VStack gives its children.
+        let rowEnvironment = environment
+            .with(\.layoutOrientation, .vertical)
+            .with(\.layoutAlignment, alignment.asStackAlignment)
+            .with(\.layoutSpacing, Int(spacing))
+            .with(\.usesZStackLayout, false)
+
+        var y = 0.0
+        var width = 0.0
+        var placed: [(id: ID, y: Double, size: ViewSize)] = []
+        var childResults: [ViewLayoutResult] = []
+        for (offset, element) in elements.enumerated() {
+            let id = ids[offset]
+            let height = children.heights[id] ?? estimate
+            if y + height >= visible.lowerBound && y <= visible.upperBound {
+                let view = BodyTracking.track { content.child(element) }
+                let node: AnyViewGraphNode<Row>
+                if let existing = children.nodes[id] {
+                    node = existing
+                } else {
+                    node = AnyViewGraphNode(for: view, backend: backend, environment: rowEnvironment)
+                    children.nodes[id] = node
+                    children.order.append(id)
+                    children.index[id] = children.order.count - 1
+                    backend.insert(node.widget.into(), into: widget, at: children.order.count - 1)
+                }
+                let result = node.computeLayout(with: view, proposedSize: rowProposal, environment: rowEnvironment)
+                children.heights[id] = result.size.height
+                width = max(width, result.size.width)
+                placed.append((id, y, result.size))
+                childResults.append(result)
+                y += result.size.height
+            } else {
+                y += height
+            }
+            if offset < elements.count - 1 { y += spacing }
+        }
+        if !environment.allowLayoutCaching {
+            children.placed = placed
+        }
+
+        // Re-layout this view when the enclosing scroll view scrolls (the
+        // node's resize hook re-runs its layout; clean rows are reused).
+        if !children.observingScroll {
+            let onResize = environment.onResize
+            children.observingScroll = Self.observeScrolling(of: widget, backend: backend) {
+                onResize(.zero)
+            }
+        }
+
+        return ViewLayoutResult(
+            size: ViewSize(proposedSize.width ?? width, y),
+            childResults: childResults
+        )
+    }
+
+    func commit<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget,
+        children: LazyVStackChildren<ID, Row>,
+        layout: ViewLayoutResult,
+        environment: EnvironmentValues,
+        backend: Backend
+    ) {
+        backend.setSize(of: widget, to: layout.size.vector)
+        let shown = Set(children.placed.map(\.id))
+        for id in children.order where !shown.contains(id) {
+            if let node = children.nodes[id] {
+                Self.setRowVisible(node.widget.into() as Backend.Widget, false, backend: backend)
+            }
+        }
+        for row in children.placed {
+            guard let node = children.nodes[row.id], let index = children.index[row.id] else { continue }
+            let size = node.commit().size
+            Self.setRowVisible(node.widget.into() as Backend.Widget, true, backend: backend)
+            let x: Double
+            switch alignment {
+                case .leading: x = 0
+                case .center: x = (layout.size.width - size.width) / 2
+                case .trailing: x = layout.size.width - size.width
+            }
+            backend.setPosition(ofChildAt: index, in: widget, to: SIMD2(Int(x.rounded()), Int(row.y.rounded())))
+        }
+        if !children.observingScroll {
+            let onResize = environment.onResize
+            children.observingScroll = Self.observeScrolling(of: widget, backend: backend) {
+                onResize(.zero)
+            }
+        }
+    }
+
+    // Backend capability helpers (no-ops without LazyStackViewportSupport).
+    private static func visibleRange<Backend: BaseAppBackend>(
+        of widget: Backend.Widget, backend: Backend
+    ) -> (offset: Double, height: Double)? {
+        func get<B: LazyStackViewportSupport>(_ backend: B) -> (offset: Double, height: Double)? {
+            backend.visibleRange(of: widget as! B.LazyWidget)
+        }
+        guard let backend = backend as? any LazyStackViewportSupport else { return nil }
+        return get(backend)
+    }
+
+    private static func observeScrolling<Backend: BaseAppBackend>(
+        of widget: Backend.Widget, backend: Backend, _ action: @escaping @MainActor () -> Void
+    ) -> Bool {
+        func observe<B: LazyStackViewportSupport>(_ backend: B) -> Bool {
+            backend.observeScrolling(of: widget as! B.LazyWidget, action)
+        }
+        guard let backend = backend as? any LazyStackViewportSupport else { return true }
+        return observe(backend)
+    }
+
+    private static func setRowVisible<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget, _ visible: Bool, backend: Backend
+    ) {
+        func set<B: LazyStackViewportSupport>(_ backend: B) {
+            backend.setRowVisible(widget as! B.LazyWidget, visible)
+        }
+        guard let backend = backend as? any LazyStackViewportSupport else { return }
+        set(backend)
+    }
+}
+
+/// The lazily created rows of a ``LazyVStack``.
+public final class LazyVStackChildren<ID: Hashable, Row: View>: ViewGraphNodeChildren {
+    var nodes: [ID: AnyViewGraphNode<Row>] = [:]
+    /// Row IDs in the container's child order.
+    var order: [ID] = []
+    var index: [ID: Int] = [:]
+    var heights: [ID: Double] = [:]
+    /// The rows placed by the last final layout.
+    var placed: [(id: ID, y: Double, size: ViewSize)] = []
+    var observingScroll = false
+
+    func reindex() {
+        index = Dictionary(uniqueKeysWithValues: order.enumerated().map { ($1, $0) })
+    }
+
+    public var widgets: [AnyWidget] {
+        order.compactMap { nodes[$0]?.widget }
+    }
+
+    public var erasedNodes: [ErasedViewGraphNode] {
+        order.compactMap { nodes[$0].map { ErasedViewGraphNode(wrapping: $0) } }
+    }
+}
