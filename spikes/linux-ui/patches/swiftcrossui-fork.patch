+// Fork change: a single-element tuple doesn't need a container of its own;
+// it uses its child's widget and passes layout straight through. (About a
+// fifth of a typical view tree's GtkFixed containers were these.) When it's
+// handed some other widget (a view that made its own container), it keeps
+// the container behaviour of Group.
+extension TupleView1 {
+    @MainActor
+    func asWidget<Backend: BaseAppBackend>(
+        _ children: Children,
+        backend: Backend
+    ) -> Backend.Widget {
+        children.child0.widget.into()
+    }
+
+    @MainActor
+    private func isPassThrough<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget, _ children: Children, backend: Backend
+    ) -> Bool {
+        if let known = children.passesThroughWidget { return known }
+        let childWidget: Backend.Widget = children.child0.widget.into()
+        let passes = (childWidget as AnyObject) === (widget as AnyObject)
+        children.passesThroughWidget = passes
+        return passes
+    }
+
+    @MainActor
+    func computeLayout<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget,
+        children: Children,
+        proposedSize: ProposedViewSize,
+        environment: EnvironmentValues,
+        backend: Backend
+    ) -> ViewLayoutResult {
+        guard isPassThrough(widget, children, backend: backend) else {
+            return Group(content: self).computeLayout(
+                widget, children: children, proposedSize: proposedSize,
+                environment: environment, backend: backend
+            )
+        }
+        let result = children.child0.computeLayout(
+            with: view0, proposedSize: proposedSize, environment: environment
+        )
+        return ViewLayoutResult(
+            size: result.size,
+            childResults: [result],
+            participateInStackLayoutsWhenEmpty: result.participateInStackLayoutsWhenEmpty
+        )
+    }
+
+    @MainActor
+    func commit<Backend: BaseAppBackend>(
+        _ widget: Backend.Widget,
+        children: Children,
+        layout: ViewLayoutResult,
+        environment: EnvironmentValues,
+        backend: Backend
+    ) {
+        guard isPassThrough(widget, children, backend: backend) else {
+            Group(content: self).commit(
+                widget, children: children, layout: layout,
+                environment: environment, backend: backend
+            )
+            return
+        }
+        _ = children.child0.commit()
+    }
+}
