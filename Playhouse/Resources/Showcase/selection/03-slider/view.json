{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10,
      "width": 360
    },
    "children": [
      {
        "type": "slider",
        "props": {
          "label": "Volume",
          "value": "{{volume}}",
          "min": 0,
          "max": 100,
          "onChange": {
            "action": "set",
            "payload": {
              "field": "volume"
            }
          }
        }
      },
      {
        "type": "slider",
        "props": {
          "label": "Effort",
          "value": "{{effort}}",
          "min": 0,
          "max": 4,
          "step": 1,
          "ticks": true,
          "onChange": {
            "action": "set",
            "payload": {
              "field": "effort"
            }
          }
        }
      },
      {
        "type": "text",
        "props": {
          "text": "volume = {{volume}}, effort = {{effort}}",
          "style": "caption",
          "color": "secondary"
        }
      }
    ]
  }
}
