{
  "main": {
    "type": "hstack",
    "props": {
      "spacing": 10,
      "alignment": "center"
    },
    "children": [
      {
        "type": "button",
        "props": {
          "title": "−",
          "disabled": "{{atZero}}",
          "onTap": {
            "action": "change",
            "payload": {
              "by": -1
            }
          }
        }
      },
      {
        "type": "text",
        "props": {
          "text": "{{count}}",
          "style": "title",
          "weight": "semibold",
          "minWidth": 48,
          "align": "center"
        }
      },
      {
        "type": "button",
        "props": {
          "title": "+",
          "onTap": {
            "action": "change",
            "payload": {
              "by": 1
            }
          }
        }
      },
      {
        "type": "button",
        "props": {
          "title": "Reset",
          "style": "borderless",
          "onTap": {
            "action": "reset"
          }
        }
      }
    ]
  }
}
