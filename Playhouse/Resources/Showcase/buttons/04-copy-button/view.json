{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "hstack",
        "props": {
          "spacing": 8
        },
        "children": [
          {
            "type": "code",
            "props": {
              "text": "npm install playhouse"
            }
          },
          {
            "type": "copy-button",
            "props": {
              "text": "npm install playhouse",
              "onCopy": {
                "action": "copied"
              }
            }
          }
        ]
      },
      {
        "type": "copy-button",
        "props": {
          "text": "Copy all",
          "title": "Copy all",
          "onCopy": {
            "action": "copied"
          }
        }
      },
      {
        "type": "text",
        "props": {
          "text": "Copied {{copies}} times",
          "style": "caption",
          "color": "secondary"
        }
      }
    ]
  }
}
