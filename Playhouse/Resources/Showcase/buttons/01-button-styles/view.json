{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 12
    },
    "children": [
      {
        "type": "hstack",
        "props": {
          "spacing": 10
        },
        "children": [
          {
            "type": "button",
            "props": {
              "title": "Bordered",
              "style": "bordered",
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "bordered"
                }
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Prominent",
              "style": "prominent",
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "prominent"
                }
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Borderless",
              "style": "borderless",
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "borderless"
                }
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Plain",
              "style": "plain",
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "plain"
                }
              }
            }
          }
        ]
      },
      {
        "type": "hstack",
        "props": {
          "spacing": 10
        },
        "children": [
          {
            "type": "button",
            "props": {
              "title": "With icon",
              "icon": "paperplane.fill",
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "with icon"
                }
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Delete",
              "icon": "trash",
              "destructive": true,
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "delete"
                }
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Disabled",
              "disabled": true,
              "onTap": {
                "action": "pressed",
                "payload": {
                  "name": "disabled"
                }
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "props": {
          "text": "Last pressed: {{last}}",
          "color": "secondary"
        }
      }
    ]
  }
}
