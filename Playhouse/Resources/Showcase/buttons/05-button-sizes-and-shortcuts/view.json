{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "hstack",
        "props": {
          "spacing": 8
        },
        "children": [
          {
            "type": "button",
            "props": {
              "title": "Mini",
              "size": "mini"
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Small",
              "size": "small"
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Regular",
              "size": "regular"
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Large",
              "size": "large"
            }
          }
        ]
      },
      {
        "type": "hstack",
        "props": {
          "spacing": 12
        },
        "children": [
          {
            "type": "button",
            "props": {
              "title": "Open settings",
              "style": "link",
              "icon": "gearshape",
              "onTap": {
                "action": "press"
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Save",
              "style": "prominent",
              "shortcut": "cmd+s",
              "onTap": {
                "action": "press"
              }
            }
          },
          {
            "type": "kbd",
            "props": {
              "keys": "cmd+s"
            }
          }
        ]
      },
      {
        "type": "text",
        "props": {
          "text": "Pressed {{presses}} times",
          "style": "caption",
          "color": "secondary"
        }
      }
    ]
  }
}
