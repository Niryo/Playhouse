{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "hstack",
        "props": {
          "spacing": 8
        },
        "children": [
          {
            "type": "textfield",
            "props": {
              "value": "{{draft}}",
              "placeholder": "Type something",
              "width": 260,
              "onChange": {
                "action": "edit"
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Add",
              "disabled": "{{!draft}}",
              "onTap": {
                "action": "add"
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "props": {
          "text": "{{draft.length}} characters: \"{{draft}}\"",
          "color": "secondary"
        }
      },
      {
        "type": "list",
        "props": {
          "items": "{{entries}}"
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "• {{item.text}}"
            }
          }
        ]
      }
    ]
  }
}
