{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "textfield",
        "props": {
          "value": "{{plain}}",
          "placeholder": "Plain field",
          "style": "plain",
          "width": 260,
          "onChange": {
            "action": "set",
            "payload": {
              "field": "plain"
            }
          },
          "onSubmit": {
            "action": "submitted"
          }
        }
      },
      {
        "type": "secure-field",
        "props": {
          "value": "{{secret}}",
          "placeholder": "Secret",
          "width": 260,
          "onChange": {
            "action": "set",
            "payload": {
              "field": "secret"
            }
          }
        }
      },
      {
        "type": "search-field",
        "props": {
          "value": "{{query}}",
          "placeholder": "Search tasks",
          "width": 260,
          "onChange": {
            "action": "set",
            "payload": {
              "field": "query"
            }
          },
          "onSubmit": {
            "action": "submitted"
          }
        }
      },
      {
        "type": "text-editor",
        "props": {
          "value": "{{notes}}",
          "placeholder": "Notes",
          "minLines": 3,
          "width": 260,
          "onChange": {
            "action": "set",
            "payload": {
              "field": "notes"
            }
          }
        }
      },
      {
        "type": "text",
        "props": {
          "text": "Plain: \u201c{{plain}}\u201d \u00b7 secret length {{secretLength}} \u00b7 query: \u201c{{query}}\u201d \u00b7 {{notes.length}} note characters \u00b7 submitted {{submits}} times",
          "style": "caption",
          "color": "secondary"
        }
      }
    ]
  }
}
