{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 12,
      "width": 360
    },
    "children": [
      {
        "type": "progress-bar",
        "props": {
          "value": "{{pct}}",
          "label": "Uploading…",
          "showValue": true
        }
      },
      {
        "type": "text",
        "props": {
          "text": "{{pct}}% {{status}}",
          "color": "secondary"
        }
      },
      {
        "type": "hstack",
        "props": {
          "spacing": 8
        },
        "children": [
          {
            "type": "button",
            "props": {
              "title": "Start",
              "style": "prominent",
              "disabled": "{{running}}",
              "onTap": {
                "action": "start"
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Reset",
              "disabled": "{{running}}",
              "onTap": {
                "action": "reset"
              }
            }
          }
        ]
      }
    ]
  }
}
