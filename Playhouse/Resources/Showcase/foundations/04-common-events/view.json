{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Click this card",
          "padding": 16,
          "background": "accent",
          "foreground": "#FFFFFF",
          "radius": 10,
          "onTap": {
            "action": "tapped"
          }
        }
      },
      {
        "type": "text",
        "props": {
          "text": "Clicked {{count}} times",
          "style": "callout",
          "color": "secondary"
        }
      }
    ]
  }
}
