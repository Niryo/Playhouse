{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "context-menu",
        "children": [
          {
            "type": "menu-item",
            "props": {
              "title": "Rename",
              "icon": "pencil",
              "onTap": {
                "action": "act",
                "payload": {
                  "what": "Rename"
                }
              }
            }
          },
          {
            "type": "menu-item",
            "props": {
              "title": "Duplicate",
              "icon": "plus.square.on.square",
              "onTap": {
                "action": "act",
                "payload": {
                  "what": "Duplicate"
                }
              }
            }
          },
          {
            "type": "divider"
          },
          {
            "type": "menu-item",
            "props": {
              "title": "Delete",
              "icon": "trash",
              "destructive": true,
              "onTap": {
                "action": "act",
                "payload": {
                  "what": "Delete"
                }
              }
            }
          },
          {
            "type": "card",
            "props": {
              "width": 240
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Right-click this card",
                  "weight": "semibold"
                }
              },
              {
                "type": "text",
                "props": {
                  "text": "Rename, Duplicate or Delete",
                  "style": "caption",
                  "color": "secondary"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "props": {
          "text": "Chosen: {{last}}",
          "style": "caption",
          "color": "secondary"
        }
      }
    ]
  }
}
