{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "button",
        "props": {
          "title": "Rename project\u2026",
          "onTap": {
            "action": "open"
          }
        }
      },
      {
        "type": "sheet",
        "props": {
          "open": "{{open}}",
          "onDismiss": {
            "action": "close"
          }
        },
        "children": [
          {
            "type": "heading",
            "props": {
              "text": "Rename project",
              "level": 3
            }
          },
          {
            "type": "textfield",
            "props": {
              "value": "{{draft}}",
              "placeholder": "Project name",
              "onChange": {
                "action": "edit"
              }
            }
          },
          {
            "type": "hstack",
            "props": {
              "spacing": 10
            },
            "children": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "props": {
                  "title": "Cancel",
                  "onTap": {
                    "action": "close"
                  }
                }
              },
              {
                "type": "button",
                "props": {
                  "title": "Save",
                  "style": "prominent",
                  "disabled": "{{!draft}}",
                  "onTap": {
                    "action": "save"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "props": {
          "text": "Name: {{name}}",
          "style": "caption",
          "color": "secondary"
        }
      }
    ]
  }
}
