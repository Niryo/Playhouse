{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 8
    },
    "children": [
      {
        "type": "hstack",
        "props": {
          "spacing": 8
        },
        "children": [
          {
            "type": "button",
            "props": {
              "title": "Add item",
              "onTap": {
                "action": "add"
              }
            }
          },
          {
            "type": "button",
            "props": {
              "title": "Remove first",
              "disabled": "{{!items.length}}",
              "onTap": {
                "action": "removeFirst"
              }
            }
          }
        ]
      },
      {
        "type": "if",
        "props": {
          "cond": "{{!items.length}}"
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "No items.",
              "color": "secondary"
            }
          }
        ]
      },
      {
        "type": "list",
        "props": {
          "items": "{{items}}"
        },
        "children": [
          {
            "type": "hstack",
            "props": {
              "spacing": 8
            },
            "children": [
              {
                "type": "icon",
                "props": {
                  "name": "circle.fill",
                  "size": 8,
                  "color": "accent"
                }
              },
              {
                "type": "text",
                "props": {
                  "text": "{{item.title}}"
                }
              },
              {
                "type": "text",
                "props": {
                  "text": "row {{index}}",
                  "style": "caption",
                  "color": "secondary"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
