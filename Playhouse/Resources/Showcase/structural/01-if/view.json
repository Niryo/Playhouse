{
  "main": {
    "type": "vstack",
    "props": {
      "spacing": 10
    },
    "children": [
      {
        "type": "button",
        "props": {
          "title": "{{toggleTitle}}",
          "onTap": {
            "action": "toggle"
          }
        }
      },
      {
        "type": "if",
        "props": {
          "cond": "{{open}}"
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "The details are visible.",
              "padding": 10,
              "background": "success",
              "foreground": "#FFFFFF",
              "radius": 6
            }
          }
        ]
      },
      {
        "type": "if",
        "props": {
          "cond": "{{!open}}"
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "The details are hidden.",
              "color": "secondary"
            }
          }
        ]
      }
    ]
  }
}
